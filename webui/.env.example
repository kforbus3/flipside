# Web UI configuration. Copy to webui/.env and edit.

# Password the `admin` user is created with on the FIRST start (stored as a
# bcrypt hash in output/users.json; once that file exists this variable is
# ignored, so a password changed in the UI is never reverted by it). Required —
# pick a strong one; the UI controls the Docker socket, which is root on the
# host. Further users and roles are managed in the UI under Users.
ADMIN_PASSWORD=

# Random secret for signing short-lived log-stream tokens. Required — generate:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# ABSOLUTE host path to this repository. Optional — leave it empty. Compose
# mounts the repo root (`..`) and the UI detects the host-side path from that
# mount, which is what the builder/imager containers need.
#
# Set it ONLY if you run `docker compose` from outside this directory, and then
# it must be the absolute host path of THIS checkout. A wrong value mounts an
# empty directory and every build fails with:
#   unable to prepare context: path "/project/builder" not found
HOST_PROJECT_DIR=

# Optional: token for the secrets manager that holds generated LUKS passphrases
# (OpenBao or HashiCorp Vault). Everything else about the store -- address,
# mount, path prefix, TLS -- is configured in the UI under Secrets Manager;
# only the credential belongs here, and only if you would rather it not be
# written to output/.secrets-store.json. A token set here wins over that file.
#
# Encrypted builds work without any of this: you then type a LUKS passphrase per
# build and keep it yourself.
BAO_TOKEN=
# VAULT_TOKEN=

# ---------------------------------------------------------------------------
# Optional: OIDC single sign-on (Keycloak, Authentik, Entra, Okta, ...).
# Entirely OFF unless both OIDC_ISSUER and OIDC_CLIENT_ID are set; password
# login keeps working either way. See docs/WEBUI.md "Single sign-on (OIDC)".

# Issuer URL, e.g. https://auth.example.com/realms/lab — discovery is fetched
# from <issuer>/.well-known/openid-configuration.
OIDC_ISSUER=
# The client registered at the IdP. Its redirect URI is
# https://<how you reach this UI>/api/auth/oidc/callback.
OIDC_CLIENT_ID=
# Optional: leave empty for a public client — the flow always uses PKCE.
OIDC_CLIENT_SECRET=

# Which ID-token claim carries the groups (default "groups"; the IdP must be
# told to include it — e.g. Keycloak needs a Group Membership mapper, Entra
# sends group object GUIDs), and how groups map to roles. A user in several
# mapped groups gets the highest role.
# OIDC_ROLE_CLAIM=groups
# OIDC_ROLE_MAP=flipside-admins=admin,flipside-ops=operator,flipside-view=viewer

# What happens to a signed-in user whose groups map to nothing: "deny"
# (default) refuses them with an audit line; viewer/operator/admin admits
# everyone the IdP vouches for at that role.
# OIDC_DEFAULT_ROLE=deny

# Label on the login page's SSO button, and the scopes requested.
# OIDC_DISPLAY_NAME=Single sign-on
# OIDC_SCOPES=openid profile email

# --- Fleet control plane -----------------------------------------------------
# Where machines reach this server once they have left the imaging network.
# Normally set on the Provisioning page (it lives in server/.env); set it here
# only to override that, e.g. when the UI is behind a reverse proxy whose public
# name is the address the fleet should use.
# CONTROL_URL=https://flipside.example.com
# How often each machine checks in, in seconds. Sent back in every reply, so
# changing it re-paces the whole fleet without touching a machine.
# AGENT_INTERVAL=300
# A shared secret agents must present. Off by default: the first check-in comes
# from a machine this server just imaged and handed no credential to. Set it
# when the control plane is reachable from a network you do not trust.
# AGENT_TOKEN=

# --- Observability -----------------------------------------------------------
# JSON logs on stdout instead of the human-readable format. Off by default:
# `make webui-logs` is nicer to read as prose, and this is for when there is
# somewhere to ship it.
# LOG_JSON=true
# LOG_LEVEL=info

# /metrics needs a viewer credential by default — it names versions in the
# field, machine counts and rollout progress, which is a fair map of the estate.
# Give Prometheus a viewer API token, or open the endpoint if it sits on a
# network where that does not matter.
# METRICS_PUBLIC=true

# Ship every audit event off the box as it happens. The local audit.jsonl is
# bounded and trimmed oldest-first, so it is a buffer rather than an archive —
# and it is on the machine being audited, which is the copy an attacker deletes.
# Delivery never blocks a request: a wedged collector costs a queue, not the API.
#   AUDIT_SYSLOG=udp://siem.example.com:514
#   AUDIT_SYSLOG=tcp://siem.example.com:601
# AUDIT_SYSLOG=
# AUDIT_SYSLOG_HOSTNAME=
# Or POST each event as one JSON object.
# AUDIT_HTTP_URL=https://collector.example.com/flipside
# AUDIT_HTTP_TOKEN=
